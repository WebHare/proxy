{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "target": "es2022",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "module": "nodenext"
  },
  "include": [
    "fsroot/opt/webhare-nginx-proxy/src/**/*.ts",
    "fsroot/opt/webhare-nginx-proxy/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
