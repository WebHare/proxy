{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
